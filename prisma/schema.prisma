generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "darwin-arm64", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // Supabase via Vercel Marketplace sets these env vars automatically.
  // Fall back to DATABASE_URL for local dev (docker-compose).
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Diagnosis {
  id              String    @id @default(cuid())
  rank            Int       @db.SmallInt  // 1-10（学習バイアス補正後・最終表示値）
  aiRawRank       Int?      @db.SmallInt @map("ai_raw_rank")  // AIの生スコア（補正前）
  biasApplied     Float?    @map("bias_applied")  // 適用したバイアス値
  advice          Json      // Array of advice items
  engineType      String    @map("engine_type")
  features        Json?     // Raw features from engine (not shown to user)
  processingTimeMs Int?     @map("processing_time_ms")
  createdAt       DateTime  @default(now()) @map("created_at")

  // ユーザーが「想定外だった」と修正したランク。null = フィードバック未実施
  correctedRank   Int?      @db.SmallInt @map("corrected_rank")
  correctionNote  String?   @map("correction_note")
  correctedAt     DateTime? @map("corrected_at")

  @@map("diagnoses")
}

model TrainingLabel {
  id        String   @id @default(cuid())
  imageUrl  String   @map("image_url")
  rank      Int      @db.SmallInt  // 1-10
  labeledBy String?  @map("labeled_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("training_labels")
}

model EngineConfig {
  id        String   @id @default(cuid())
  name      String   @unique
  type      String   // e.g., "similarity", "cnn", "embedding"
  version   String
  isActive  Boolean  @default(false) @map("is_active")
  config    Json?    // Engine-specific configuration
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("engine_configs")
}
